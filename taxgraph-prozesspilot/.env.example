# LOCAL DEFAULT: URL http://127.0.0.1:8080, no login required.
APP_ENV=local
BIND_ADDRESS=127.0.0.1
PORT=8080
APP_USER=admin
APP_PASSWORD=
MCP_API_KEY=
# HOSTED DEMO: Change APP_ENV=production and set APP_PASSWORD with 16+ chars.
# Serve behind an HTTPS reverse proxy. Bind remains 127.0.0.1 on a VPS.
# APP_ENV=production
# APP_PASSWORD=replace-with-a-long-random-unique-password

# Optional public demo mode: visitors share one synthetic workspace and can switch roles.
# Enable only for synthetic data; role selection is unavailable in production mode.
# APP_DEMO_ROLE_SWITCH=1
# APP_LOCAL_ROLE=editor
